# Server
PORT=5000
BASE_PATH=/
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (publishable client values; do not commit service-role keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database (server-only)
DATABASE_URL=

# Admin bootstrap: comma-separated authenticated user IDs
CAMPUS_ADMIN_USER_IDS=

# AI integration intentionally disabled for the current product phase.

# Server-only privileged identities. Configure only in the API runtime secret store.
# Never expose this value through VITE_ or EXPO_PUBLIC_ variables.
CAMPUS_SUPERADMIN_EMAILS=
