# Server
PORT=5000
BASE_PATH=/
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (publishable client values; do not commit service-role keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database (server-only)
DATABASE_URL=

# Admin bootstrap: comma-separated authenticated user IDs
CAMPUS_ADMIN_USER_IDS=

# AI integration intentionally disabled for the current product phase.

# Server-only privileged identities. Configure only in the API runtime secret store.
# Never expose this value through VITE_ or EXPO_PUBLIC_ variables.
CAMPUS_SUPERADMIN_EMAILS=
# Phase 12 acceptance environment. Reserved placeholders only.
# Use a dedicated local or disposable test project. Never use production.
SUPABASE_TEST_URL=https://project-ref.supabase.co
SUPABASE_TEST_ANON_KEY=replace-with-test-publishable-key
SUPABASE_TEST_SERVICE_ROLE_KEY=replace-in-local-env-only
ACCEPTANCE_API_URL=http://127.0.0.1:5000
ACCEPTANCE_WEB_URL=http://127.0.0.1:4173
ACCEPTANCE_ENVIRONMENT_ID=abi-mizrak-acceptance-only
ACCEPTANCE_STUDENT_A_EMAIL=student-a@example.invalid
ACCEPTANCE_STUDENT_A_PASSWORD=replace-in-local-env-only
ACCEPTANCE_STUDENT_B_EMAIL=student-b@example.invalid
ACCEPTANCE_STUDENT_B_PASSWORD=replace-in-local-env-only
ACCEPTANCE_TEACHER_EMAIL=teacher@example.invalid
ACCEPTANCE_TEACHER_PASSWORD=replace-in-local-env-only
ACCEPTANCE_ADMIN_EMAIL=administrator@example.invalid
ACCEPTANCE_ADMIN_PASSWORD=replace-in-local-env-only
ACCEPTANCE_NON_MEMBER_EMAIL=non-member@example.invalid
ACCEPTANCE_NON_MEMBER_PASSWORD=replace-in-local-env-only
